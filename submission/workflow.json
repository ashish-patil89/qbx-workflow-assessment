    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst failure = {\n  timestamp: new Date().toISOString(),\n  service: 'slack',\n  incidentId: input.incidentId || 'unknown',\n  statusCode: input.statusCode || 'unknown',\n  error: input.message || 'unknown error'\n};\n\nconst content = JSON.stringify(failure) + '\\n';\nconst encoded = Buffer.from(content).toString('base64');\n\nreturn [{\n  json: failure,\n  binary: {\n    data: {\n      data: encoded,\n      mimeType: 'application/json',\n      fileName: 'failures.jsonl'\n    }\n  }\n}];"
