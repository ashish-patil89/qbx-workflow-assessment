    {
      "parameters": {
        "jsCode": "const item = $input.first().json.body;\n\nconst requiredFields = ['incidentId', 'severity', 'title', 'createdAt'];\nfor (const field of requiredFields) {\n  if (!item[field]) {\n    throw new Error(`Missing required field: ${field}`);\n  }\n}\n\nconst severityMap = { P1: 1, P2: 2, P3: 3, P4: 4 };\nconst severityNum = severityMap[item.severity];\nif (!severityNum) {\n  throw new Error(`Invalid severity value: ${item.severity}`);\n}\n\nfunction simpleHash(str) {\n  let hash = 0;\n  for (let i = 0; i < str.length; i++) {\n    const char = str.charCodeAt(i);\n    hash = ((hash << 5) - hash) + char;\n    hash = hash & hash; // Convert to 32bit integer\n  }\n  return Math.abs(hash).toString(16);\n}\n\nconst rawKey = `${item.incidentId}|${item.severity}|${item.createdAt}`;\nconst dedupeKey = simpleHash(rawKey);\n\nconst staticData = $getWorkflowStaticData('global');\nif (staticData[dedupeKey]) {\n  throw new Error(`Duplicate event detected. Already processed: ${item.incidentId}`);\n}\nstaticData[dedupeKey] = true;\n\nconst description = (item.description || '').substring(0, 240);\n\nconst message = `[${item.severity}/P${severityNum}] ${item.title} (${item.incidentId})\nDescription: ${description}\nStore: ${item.storeId || 'N/A'}\nCreated: ${item.createdAt}\nOwner: ${item.ownerEmail}`;\n\nreturn [{\n  json: {\n    incidentId: item.incidentId,\n    severity: item.severity,\n    severityNum,\n    title: item.title,\n    description,\n    createdAt: item.createdAt,\n    ownerEmail: item.ownerEmail,\n    storeId: item.storeId || null,\n    dedupeKey,\n    message\n  }\n}];"
      },
